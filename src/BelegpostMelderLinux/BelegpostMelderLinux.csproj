<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>belegpost-melder</AssemblyName>
    <RootNamespace>BelegpostMelder</RootNamespace>
    <Product>Belegpost Melder (Linux)</Product>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Verbindung zum Server: dieselbe Klasse wie im Windows-Melder -->
    <Compile Include="..\BelegpostMelder\MelderClient.cs" Link="MelderClient.cs" />
    <EmbeddedResource Include="melder.png" LogicalName="melder.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia (MIT) für Fenster und Symbol im Infobereich -->
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
  </ItemGroup>

</Project>
