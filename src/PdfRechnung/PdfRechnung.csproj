<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PdfRechnung</RootNamespace>
    <AssemblyName>Belegpost</AssemblyName>
    <Product>Belegpost</Product>
    <Company>Belegpost</Company>
    <!-- Ziel: Windows Server / Windows 10/11 x64 -->
    <RuntimeIdentifier Condition="'$(OS)' == 'Windows_NT' Or '$(Configuration)' == 'Release'">win-x64</RuntimeIdentifier>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationIcon>Belegpost.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- dotnet publish -c Release → eine Belegpost.exe inkl. .NET-Laufzeit (auf dem Server muss nichts installiert werden) + wwwroot -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- PDF drucken (Weiterleitung an gotomaxx): PDFium, BSD-3/Apache-2.0 -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="159.0.8152" />
    <PackageReference Include="FluentFTP" Version="55.1.0" />
    <PackageReference Include="HtmlSanitizer" Version="11.0.26" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <!-- PDF lesen (Apache-2.0) -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- E-Mail-Versand (MIT) -->
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="SaxonCS-HE" Version="13.1.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.1" />
    <PackageReference Include="System.DirectoryServices" Version="10.0.0" />
    <!-- Windows-Druck (PrintDocument), MIT -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.15" />
  </ItemGroup>

  <!-- MAPI-Mailclient (src/BelegpostMapi/build.sh) neben Belegpost.exe ausliefern -->
  <ItemGroup>
    <Content Remove="Documents\ERechnungFelder.json" />
    <EmbeddedResource Include="Documents\ERechnungFelder.json" LogicalName="ERechnungFelder.json" />
    <EmbeddedResource Include="Edi\Verzeichnisse\*.json.gz" LogicalName="Edi.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Edi\Validierung.zip" LogicalName="Edi.Validierung.zip" />
    <Content Remove="Connect\ErpSuiteConnect.json" />
    <EmbeddedResource Include="Connect\ErpSuiteConnect.json" LogicalName="ErpSuiteConnect.json" />
    <!-- Registrierungstoken der Lizenz-API: liegt nur lokal (nicht im Git), wird beim Bauen eingebettet -->
    <EmbeddedResource Include="Licensing\registration.token" LogicalName="Licensing.registration.token" Condition="Exists('Licensing\registration.token')" />
    <None Include="..\BelegpostMapi\out\BelegpostMapi-*.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PdfRechnung.Tests" />
  </ItemGroup>

  <Target Name="WarnMissingLicenseToken" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release' And !Exists('Licensing\registration.token')">
    <Warning Text="Licensing\registration.token fehlt – diese Belegpost.exe kann sich nicht beim Lizenzserver registrieren." />
  </Target>
</Project>
