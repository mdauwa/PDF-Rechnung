<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PdfRechnung</RootNamespace>
    <AssemblyName>PdfRechnung</AssemblyName>
    <Version>0.1.0</Version>
    <Product>PDF Rechnung</Product>
    <Company>ERP Austria</Company>
    <!-- Ziel: Windows Server / Windows 10/11 x64 -->
    <RuntimeIdentifier Condition="'$(OS)' == 'Windows_NT' Or '$(Configuration)' == 'Release'">win-x64</RuntimeIdentifier>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationIcon>PdfRechnung.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- dotnet publish -c Release → eine PdfRechnung.exe inkl. .NET-Laufzeit (auf dem Server muss nichts installiert werden) + wwwroot -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.22" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="9.0.22" />
    <!-- PDF lesen (Apache-2.0) -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- E-Mail-Versand (MIT) -->
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PdfRechnung.Tests" />
  </ItemGroup>

</Project>
